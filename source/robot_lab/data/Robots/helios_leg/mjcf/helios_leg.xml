<mujoco model="helios_leg">
    <compiler angle="radian" meshdir="../meshes/" eulerseq="zyx"/>
    <option timestep='0.001' iterations='50' solver='PGS' gravity='0 0 -9.81'>
        <flag frictionloss="enable" sensor="enable"/>
    </option>
    <size njmax="500" nconmax="100" />

    <visual>
        <quality shadowsize="4096"/>
        <map znear="0.05"/>
        <global offwidth="1920" offheight="1080"/>
    </visual>

    <default>
        <joint limited="true"/>
        <motor ctrllimited="true"/>
        <geom condim="4" contype="1" conaffinity="15" solref="0.001 2" friction="0.9 0.2 0.2"/>
        <equality solref="0.001 2"/>
        <default class="leg_joint_param">
            <joint damping="0.01" frictionloss="0.01" armature="0.01"/>
        </default>
    </default>

    <asset>
        <mesh name="base_link" file="base_link.STL" />
        <mesh name="right_thigh_link" file="right_thigh_link.STL" />
        <mesh name="right_calf_link" file="right_calf_link.STL" />
        <mesh name="right_foot_link" file="right_foot_link.STL" />
        <mesh name="left_thigh_link" file="left_thigh_link.STL" />
        <mesh name="left_calf_link" file="left_calf_link.STL" />
        <mesh name="left_foot_link" file="left_foot_link.STL" />
        <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
        <material name="matgeom" texture="texgeom" texuniform="true" rgba="0.8 0.6 .4 1"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <texture name="texgeom" type="cube" builtin="flat" mark="cross" width="127" height="1278" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1" random="0.01"/>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2=".6 .8 1" width="256" height="256"/>
    </asset>

    <worldbody>
        <!-- 灯光 -->
        <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false"/>
        <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>
        <!-- 地面 -->
        <geom name="ground" type="plane" size="0 0 1" pos="0.001 0 0" quat="1 0 0 0" material="matplane" condim="1" conaffinity='15'/>

        <body name="base_link" pos='0 0 0.32'>
            <!-- IMU 传感器位置 -->
            <site name='imu' size='0.01' pos='0.0 0 0.0' quat='1 0 0 0'/>
            <!-- base_link 惯性参数 -->
            <inertial pos="-0.0384 -0.0009 -0.0655" mass="7.3247"
                      fullinertia="0.1185 0.1507 0.2153 0.0001 0.0038 0.0004"/>
            <!-- 自由关节 -->
            <joint name="floating_base_joint" type="free" limited='false'/>
            <!-- 视觉网格 -->
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="base_link" />
            <!-- base_link 碰撞体 (group=2 不可见) -->
            <geom name="base_collision_main" type="box" size="0.23 0.12 0.09" pos="-0.04 0 -0.1" group="2"/>
            <geom name="base_collision_right" type="cylinder" size="0.05 0.04" pos="-0.034 -0.12 -0.03" quat="0.707105 0.707108 0 0" group="2"/>
            <geom name="base_collision_left" type="cylinder" size="0.05 0.04" pos="-0.034 0.12 -0.03" quat="0.707105 0.707108 0 0" group="2"/>

            <body name="right_thigh_link" pos="-0.0337728 -0.164615 -0.0275">
                <inertial pos="-0.0137451 0.0110123 0.0984246" quat="0.706065 -0.0270668 -0.0552791 0.705467" mass="0.29712" diaginertia="0.0020344 0.00192086 0.000140442" />
                <joint name="right_thigh_joint" pos="0 0 0" axis="0 -1 0" limited="true" range="0.7 2.7" actuatorfrcrange="-40 40" class="leg_joint_param"/>
                <!-- 视觉网格 -->
                <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="right_thigh_link" />
                <!-- 碰撞体 -->
                <geom name="right_thigh_motor" type="cylinder" size="0.035 0.05" pos="0 0.02 0" quat="0.707105 0.707108 0 0" group="2"/>
                <geom name="right_thigh_link_col" type="cylinder" size="0.025 0.1" pos="-0.01 0 0.11" group="2"/>

                <body name="right_calf_link" pos="-0.0331636 -0.0185 0.212427">
                    <inertial pos="-0.083871 0.0078304 0.047461" quat="0.353918 0.607188 0.610724 0.364802" mass="0.312366" diaginertia="0.00366667 0.00351845 0.000176974" />
                    <joint name="right_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.1 0.9" actuatorfrcrange="-40 40" class="leg_joint_param"/>
                    <!-- 视觉网格 -->
                    <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="right_calf_link" />
                    <!-- 碰撞体 -->
                    <geom name="right_calf_motor" type="cylinder" size="0.03 0.03" pos="0 0.015 0" quat="0.707105 0.707108 0 0" group="2"/>
                    <geom name="right_calf_link1" type="cylinder" size="0.015 0.1" pos="-0.09 0.01 0.06" quat="0.540302 0 0.841471 0" group="2"/>
                    <geom name="right_calf_link2" type="cylinder" size="0.02 0.01" pos="-0.2 0.01 0.11" quat="0.973666 0 0.227978 0" group="2"/>

                    <body name="right_foot_link" pos="-0.226464 -0.0392 0.123605">
                        <inertial pos="-1.5e-06 0.0197779 -1.14e-05" quat="0.371748 0.601501 0.601501 0.371748" mass="1.10155" diaginertia="0.0013495 0.0008536 0.0008531" />
                        <joint name="right_foot_joint" type="hinge" pos="0 0 0" axis="0 1 0" limited="false" actuatorfrcrange="-40 40" class="leg_joint_param"/>
                        <!-- 视觉网格 -->
                        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.90196 0.92157 0.92157 1" mesh="right_foot_link" />
                        <!-- 碰撞体: 轮子 -->
                        <geom name="right_wheel_collision" type="cylinder" size="0.05 0.02" pos="0 0.02 0" quat="0.707105 0.707108 0 0" group="2"/>
                    </body>
                </body>
            </body>

            <body name="left_thigh_link" pos="-0.0337728 0.164615 -0.0275">
                <inertial pos="-0.0137451 -0.0110123 0.0984246" quat="0.705467 -0.0552791 -0.0270668 0.706065" mass="0.29712" diaginertia="0.0020344 0.00192086 0.000140442" />
                <joint name="left_thigh_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.7 -0.7" actuatorfrcrange="-40 40" class="leg_joint_param"/>
                <!-- 视觉网格 -->
                <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.89804 0.91765 0.92941 1" mesh="left_thigh_link" />
                <!-- 碰撞体 -->
                <geom name="left_thigh_motor" type="cylinder" size="0.035 0.05" pos="0 -0.02 0" quat="0.707105 0.707108 0 0" group="2"/>
                <geom name="left_thigh_link_col" type="cylinder" size="0.025 0.1" pos="-0.01 0 0.11" group="2"/>

                <body name="left_calf_link" pos="-0.0331636 0.0185 0.212427">
                    <inertial pos="-0.083871 -0.0078304 0.047461" quat="0.364802 0.610724 0.607188 0.353918" mass="0.312366" diaginertia="0.00366667 0.00351845 0.000176974" />
                    <joint name="left_calf_joint" pos="0 0 0" axis="0 -1 0" limited="true" range="-0.9 2.1" actuatorfrcrange="-40 40" class="leg_joint_param"/>
                    <!-- 视觉网格 -->
                    <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="left_calf_link" />
                    <!-- 碰撞体 -->
                    <geom name="left_calf_motor" type="cylinder" size="0.03 0.03" pos="0 -0.015 0" quat="0.707105 0.707108 0 0" group="2"/>
                    <geom name="left_calf_link1" type="cylinder" size="0.015 0.1" pos="-0.09 -0.01 0.06" quat="0.540302 0 0.841471 0" group="2"/>
                    <geom name="left_calf_link2" type="cylinder" size="0.02 0.01" pos="-0.2 -0.01 0.11" quat="0.973666 0 0.227978 0" group="2"/>

                    <body name="left_foot_link" pos="-0.226464 0.0392 0.123605">
                        <inertial pos="-1.5e-06 -0.0197779 -1.14e-05" quat="0.371748 0.601501 0.601501 0.371748" mass="1.10155" diaginertia="0.0013495 0.0008536 0.0008531" />
                        <joint name="left_foot_joint" type="hinge" pos="0 0 0" axis="0 -1 0" limited="false" actuatorfrcrange="-40 40" class="leg_joint_param"/>
                        <!-- 视觉网格 -->
                        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.89804 0.91765 0.92941 1" mesh="left_foot_link" />
                        <!-- 碰撞体: 轮子 -->
                        <geom name="left_wheel_collision" type="cylinder" size="0.05 0.02" pos="0 -0.02 0" quat="0.707105 0.707108 0 0" group="2"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- 右腿关节 - 40Nm (匹配URDF effort限制) -->
        <motor name="right_thigh_joint" joint="right_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
        <motor name="right_calf_joint" joint="right_calf_joint" gear="1" ctrllimited="true" ctrlrange="-200 200"/>

        <!-- 左腿关节 - 40Nm -->
        <motor name="left_thigh_joint" joint="left_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
        <motor name="left_calf_joint" joint="left_calf_joint" gear="1" ctrllimited="true" ctrlrange="-200 200"/>

        <!-- 轮子关节 - 40Nm -->
        <motor name="right_foot_joint" joint="right_foot_joint" gear="1" ctrllimited="true" ctrlrange="-60 60"/>
        <motor name="left_foot_joint" joint="left_foot_joint" gear="1" ctrllimited="true" ctrlrange="-60 60"/>
    </actuator>

    <sensor>
        <framequat     name='orientation' objtype='site' noise='0.001' objname='imu'/>
        <framepos      name='position' objtype='site' noise='0.001' objname='imu'/>
        <gyro          name='angular-velocity'    site='imu' noise='0.005' cutoff='34.9'/>
        <velocimeter   name='linear-velocity'     site='imu' noise='0.001' cutoff='30'/>
        <accelerometer name='linear-acceleration' site='imu' noise='0.005' cutoff='157'/>
        <magnetometer  name='magnetometer'        site='imu'/>
    </sensor>
</mujoco>
